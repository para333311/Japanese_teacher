{
  "name": "japanese-teacher-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute japanese-teacher-bot-db --local --file=migrations/0001_init.sql",
    "db:remote": "wrangler d1 execute japanese-teacher-bot-db --remote --file=migrations/0001_init.sql",
    "build:phrases": "python3 scripts/build_phrases.py"
  },
  "devDependencies": {
    "wrangler": "^3.99.0"
  }
}
