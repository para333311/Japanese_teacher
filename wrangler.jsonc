{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japanese-teacher-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // 하루 1회, 낮 12시(KST) = 03:00 UTC. (3시간 간격에서 변경)
  // 발송 뒤 집 PC 예약작업(scripts/clip_task.ps1 → daily_clip.py)이 그 말이
  // 실제로 들리는 유튜브 클립을 찾아 영상으로 뒤따라 보낸다.
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japanese-teacher-bot-db",
      "database_id": "placeholder"
    }
  ],

  "vars": {
    // 안내 문구에만 쓰인다("N시간마다 한 문장"). 하루 1회로 바뀌었으니 24.
    "INTERVAL_HOURS": "24",
    "TIMEZONE": "Asia/Seoul",
    "QUIET_ENABLED": "true",
    "QUIET_START_HOUR": "0",
    "QUIET_END_HOUR": "7",
    // TTS mp3 는 그만 보낸다 — 대신 실제 영상 클립이 따라간다(daily_clip.py).
    // 클립 쪽이 죽었을 때 되살리려면 "true" 로.
    "SEND_VOICE": "false",
    "SHOW_JAPANESE": "false",
    // 발음 음성 속도. "+0%" 가 원어민 보통 속도.
    // 더 빠르게: "+15%" ~ "+30%" / 더 천천히: "-15%"
    "VOICE_RATE": "+0%",
    // ja-JP-NanamiNeural(여성) 또는 ja-JP-KeitaNeural(남성)
    "VOICE_NAME": "ja-JP-NanamiNeural"
  }
}
