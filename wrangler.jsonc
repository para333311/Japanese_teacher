{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japanese-teacher-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // 하루 1회, 낮 12시(KST) = 03:00 UTC. (3시간 간격에서 변경)
  "triggers": {
    "crons": ["0 3 * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japanese-teacher-bot-db",
      "database_id": "placeholder"
    }
  ],

  "vars": {
    // 안내 문구에만 쓰인다("N시간마다 한 문장"). 하루 1회로 바뀌었으니 24.
    "INTERVAL_HOURS": "24",
    "TIMEZONE": "Asia/Seoul",
    "QUIET_ENABLED": "true",
    "QUIET_START_HOUR": "0",
    "QUIET_END_HOUR": "7",
    // 2026-09-26 파라님 「말미에 mp3 주는 거 부활, 영상 찾는 건 폐지」 — 발음 mp3 를 다시 붙인다.
    "SEND_VOICE": "true",
    "SHOW_JAPANESE": "false",
    // 발음 음성 속도. "+0%" 가 원어민 보통 속도.
    // 더 빠르게: "+15%" ~ "+30%" / 더 천천히: "-15%"
    "VOICE_RATE": "+0%",
    // ja-JP-NanamiNeural(여성) 또는 ja-JP-KeitaNeural(남성)
    "VOICE_NAME": "ja-JP-NanamiNeural"
  }
}
