{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "japanese-teacher-bot",
  "main": "src/index.js",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // 1시간마다 실행 (조용한 시간은 코드에서 걸러냄)
  "triggers": {
    "crons": ["0 * * * *"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "japanese-teacher-bot-db",
      "database_id": "placeholder"
    }
  ],

  "vars": {
    "INTERVAL_HOURS": "1",
    "TIMEZONE": "Asia/Seoul",
    "QUIET_ENABLED": "true",
    "QUIET_START_HOUR": "0",
    "QUIET_END_HOUR": "7",
    "SEND_VOICE": "true",
    "SHOW_JAPANESE": "false",
    // 발음 음성 속도. "+0%" 가 원어민 보통 속도.
    // 더 빠르게: "+15%" ~ "+30%" / 더 천천히: "-15%"
    "VOICE_RATE": "+0%",
    // ja-JP-NanamiNeural(여성) 또는 ja-JP-KeitaNeural(남성)
    "VOICE_NAME": "ja-JP-NanamiNeural"
  }
}
